# MongoDB Atlas free-tier connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/paper-trading

# Any random long string
JWT_SECRET=change_this_to_a_long_random_string

# Free API key from https://twelvedata.com (used for XAUUSD and EURUSD)
TWELVEDATA_API_KEY=your_twelvedata_key

# Starting virtual balance for new accounts
STARTING_BALANCE=100000

PORT=5000
